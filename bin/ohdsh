#!/usr/bin/env sh
set -eu

# Resolve $0 through symlinks (macOS readlink has no -f) so an
# /usr/local/bin link still finds the installed application.
SCRIPT=$0
while [ -L "$SCRIPT" ]; do
  TARGET=$(readlink "$SCRIPT")
  case $TARGET in
    /*) SCRIPT=$TARGET ;;
    *) SCRIPT=$(dirname -- "$SCRIPT")/$TARGET ;;
  esac
done

ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd -P)

if [ -x "$ROOT/node-runtime/bin/node" ] && [ -f "$ROOT/lib/oh-dsh/cli.js" ]; then
  export DSH_OH_WEB_ROOT="$ROOT"
  export DSH_OH_TUI_ROOT="$ROOT"
  case "$ROOT" in
    */Contents/Resources)
      export OH_DSH_DESKTOP_APP="${ROOT%/Contents/Resources}"
      ;;
  esac
  exec "$ROOT/node-runtime/bin/node" "$ROOT/lib/oh-dsh/cli.js" "$@"
fi

if [ ! -f "$ROOT/dist/ohdsh.js" ]; then
  printf '%s\n' 'Oh-DSH is not built. Run pnpm run build first.' >&2
  exit 1
fi

export OH_DSH_SOURCE_ROOT="$ROOT"
exec node "$ROOT/dist/ohdsh.js" "$@"
