{
  "name": "@oh-dsh/desktop",
  "productName": "Oh-DSH-Desktop",
  "version": "0.1.1",
  "description": "An extensible DeepSeek Harness plugin collection and Electron desktop distribution",
  "author": "dsh-external",
  "desktopName": "oh-dsh-desktop.desktop",
  "packageManager": "pnpm@11.20.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": {
      "default": "./dist/plugin.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./dist/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/plugin.js",
    "dist/client.js",
    "dist/client.js.map",
    "dist/cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dist/cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@oh-dsh/panel-controls",
        "@oh-dsh/pinned-summary",
        "@oh-dsh/desktop-sidebar",
        "@oh-dsh/plugin-marketplace"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "stage:dsh": "node scripts/stage-dsh.mjs",
    "check:plugins": "node scripts/smoke-runtime.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:app": "node scripts/smoke-runtime.mjs \"release/mac-arm64/Oh-DSH-Desktop.app/Contents/Resources\"",
    "smoke:app:linux": "node scripts/smoke-runtime.mjs \"release/linux-unpacked/resources\" && node scripts/smoke-packaged-app.mjs \"release/linux-unpacked/oh-dsh-desktop\"",
    "smoke:app:win": "node scripts/smoke-runtime.mjs \"release/win-unpacked/resources\" && node scripts/smoke-packaged-app.mjs \"release/win-unpacked/Oh-DSH-Desktop.exe\"",
    "install:mac": "node scripts/install-mac.mjs",
    "start": "pnpm run build && pnpm run stage:dsh && electron .",
    "check:screenshot": "electron scripts/check-screenshot-corners.cjs assets/oh-dsh-desktop-ui.png",
    "generate:portable-splash": "electron scripts/generate-portable-splash.cjs --disable-gpu",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dist:mac": "pnpm run build && pnpm run build:dsh && pnpm run stage:dsh && node scripts/build-mac.mjs",
    "dist:mac:quick": "pnpm run build && pnpm run stage:dsh && node scripts/build-mac.mjs",
    "dist:linux": "pnpm run build && pnpm run build:dsh && pnpm run stage:dsh && node scripts/build-linux.mjs",
    "dist:linux:quick": "pnpm run build && pnpm run stage:dsh && node scripts/build-linux.mjs",
    "dist:win": "pnpm run build && pnpm run build:dsh && pnpm run stage:dsh && node scripts/build-windows.mjs",
    "dist:win:quick": "pnpm run build && pnpm run stage:dsh && node scripts/build-windows.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "42.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "pnpm": "11.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "ai.deepseek.oh-dsh-desktop",
    "productName": "Oh-DSH-Desktop",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/main.js",
      "dist/preload.cjs",
      "dist/splash.html",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".stage",
        "to": ".",
        "filter": [
          "dsh-runtime/**/*",
          "node-runtime/**/*"
        ]
      },
      {
        "from": "assets/icons/512x512.png",
        "to": "oh-dsh-desktop.png"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/Oh-DSH-Desktop.icns",
      "identity": null,
      "darkModeSupport": true,
      "minimumSystemVersion": "12.0.0",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Oh-DSH-Desktop uses Apple Events only when a DeepSeek Harness tool needs to interact with a Mac app.",
        "NSDesktopFolderUsageDescription": "Oh-DSH-Desktop needs access to workspaces you select on the Desktop.",
        "NSDocumentsFolderUsageDescription": "Oh-DSH-Desktop needs access to workspaces you select in Documents.",
        "NSDownloadsFolderUsageDescription": "Oh-DSH-Desktop needs access to workspaces you select in Downloads."
      }
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icons",
      "maintainer": "dsh-external",
      "executableName": "oh-dsh-desktop",
      "syncDesktopName": true,
      "synopsis": "An extensible DeepSeek Harness desktop workbench",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Oh-DSH-Desktop-${version}-windows-${arch}-setup.${ext}",
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Oh-DSH-Desktop-${version}-windows-${arch}-portable.${ext}",
      "splashImage": "assets/portable-splash.bmp"
    },
    "dmg": {
      "title": "Oh-DSH-Desktop ${version}",
      "artifactName": "Oh-DSH-Desktop-${version}-${arch}.${ext}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 185,
          "type": "file"
        },
        {
          "x": 400,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "artifactName": "Oh-DSH-Desktop-${version}-${arch}.${ext}"
  }
}
